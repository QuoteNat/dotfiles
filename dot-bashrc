# .bashrc

# Source global definitions
if [ -f /etc/bashrc ]; then
  . /etc/bashrc
fi

# User specific environment
if ! [[ "$PATH" =~ "$HOME/.local/bin:$HOME/bin:" ]]; then
  PATH="$HOME/.local/bin:$HOME/bin:$PATH"
fi
export PATH

# Uncomment the following line if you don't like systemctl's auto-paging feature:
# export SYSTEMD_PAGER=

# User specific aliases and functions
if [ -d ~/.bashrc.d ]; then
  for rc in ~/.bashrc.d/*; do
    if [ -f "$rc" ]; then
      . "$rc"
    fi
  done
fi
unset rc

# Add bitwarden ssh agent
export SSH_AUTH_SOCK=/home/nat/.var/app/com.bitwarden.desktop/data/.bitwarden-ssh-agent.sock

# Add packwiz completion
source <(packwiz completion bash 2>/dev/null)

if zoxide -V &>/dev/null; then
  eval "$(zoxide init bash)"
  alias cd="z"
fi

if fzf --version &>/dev/null; then
  # Set up fzf key bindings and fuzzy completion
  eval "$(fzf --bash)"
fi

if nvim --version &>/dev/null; then
  alias vim="nvim"
fi

alias gearlever='flatpak run it.mijorus.gearlever'

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"                   # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion" # This loads nvm bash_completion
. "$HOME/.cargo/env"

eval "$(/home/nat/.local/bin/mise activate bash)" # added by https://mise.run/bash
